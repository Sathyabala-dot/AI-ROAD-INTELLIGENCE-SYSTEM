# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Option A: single connection string (takes priority if set)
# DATABASE_URL=postgresql://road_user:your_password@localhost:5432/road_health_db

# Option B: individual fields (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=road_health_db
DB_USER=road_user
DB_PASSWORD=change_me
